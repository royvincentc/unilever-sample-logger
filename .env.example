VITE_N8N_API_KEY=YOUR_SECRET_API_KEY_HERE
TELEGRAM_BOT_TOKEN=YOUR_TELEGRAM_BOT_TOKEN
TELEGRAM_CHAT_ID=YOUR_TELEGRAM_CHAT_ID

# Collaboration: apply the reviewed Supabase migrations before setting these.
# Create a Google OAuth web client and register
# https://YOUR_DEPLOYMENT_HOST/api/collaboration-auth/callback as its redirect URI.
COLLAB_GOOGLE_CLIENT_ID=GOOGLE_OAUTH_WEB_CLIENT_ID
COLLAB_GOOGLE_CLIENT_SECRET=SERVER_ONLY_GOOGLE_OAUTH_CLIENT_SECRET
COLLAB_GOOGLE_REDIRECT_URI=https://YOUR_DEPLOYMENT_HOST/api/collaboration-auth/callback
COLLAB_SESSION_SECRET=SERVER_ONLY_RANDOM_SECRET_AT_LEAST_32_CHARACTERS
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_SERVICE_ROLE_KEY=SERVER_ONLY_SERVICE_ROLE_KEY
COLLABORATION_WORKSPACE_ID=YOUR_WORKSPACE_UUID
VITE_COLLABORATION_WORKSPACE_ID=YOUR_WORKSPACE_UUID
# Drive uses existing GCP_CREDENTIALS_JSON/GOOGLE_CREDENTIALS for Shared Drives,
# or all three server-only OAuth settings for My Drive.
DRIVE_OAUTH_CLIENT_ID=
DRIVE_OAUTH_CLIENT_SECRET=
DRIVE_OAUTH_REFRESH_TOKEN=
CRON_SECRET=SERVER_ONLY_RANDOM_SECRET
